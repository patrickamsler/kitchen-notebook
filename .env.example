# Local development settings for compose.yaml and the backend.
# Copy to .env (gitignored): cp .env.example .env
#
# LOCAL-ONLY VALUES. These passwords and secrets exist only for the local Docker stack and CI.
# Never reuse them anywhere else, and never put real secrets in this file.

# --- PostgreSQL ---------------------------------------------------------------
# Superuser of the local cluster (used only by the init script in infra/postgres/init/).
POSTGRES_PASSWORD=local-postgres-pw
# Schema owner, used only by Flyway.
KN_OWNER_PASSWORD=local-kn-owner-pw
# Runtime role of the backend (no BYPASSRLS, owns nothing).
KN_APP_PASSWORD=local-kn-app-pw
# Keycloak's own database user.
KEYCLOAK_DB_PASSWORD=local-keycloak-db-pw

# --- Keycloak (http://localhost:8180) ------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-pw
# Secret of the confidential client kn-web; the realm import and the backend read the same value.
KN_WEB_CLIENT_SECRET=local-kn-web-secret
# Password of the verified test users anna@example.com and ben@example.com.
KN_TEST_USER_PASSWORD=local-test-pw

# --- Mailpit (SMTP localhost:1025, web UI http://localhost:8025) ---------------
# No settings needed; Mailpit accepts any mail and never delivers it.

# --- MinIO (S3 API http://localhost:9000, console http://localhost:9001) -------
MINIO_ROOT_USER=kn-minio
MINIO_ROOT_PASSWORD=local-minio-pw
